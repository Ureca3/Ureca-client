    "framer-motion": "^12.27.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-audio-visualizer-pro": "^0.4.1",
    "react-dom": "19.2.3",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@eslint/js": "^9.39.2",
    "@storybook/nextjs": "^10.1.11",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/eslint-plugin-jsx-a11y": "^6",
